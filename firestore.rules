rules_version = '2';
// Reglas de Hybrid Coach. Copia de lo publicado en Firebase (Firestore → Reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "maria.caparros.m@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function soyYo(uid) { return request.auth != null && request.auth.uid == uid; }

    // Suscriptoras: cada una ve y edita su ficha (sin poder cambiarse el estado); la administradora, todas.
    match /users/{uid} {
      allow read: if soyYo(uid) || isAdmin();
      allow create: if soyYo(uid) && request.resource.data.estado == "pendiente"
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        || (soyYo(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ultimaVez", "instalada", "plataforma"]));
      allow delete: if soyYo(uid) || isAdmin();
    }

    // Contenido personalizado: solo lo escribe la administradora y solo lo lee la suscriptora aprobada.
    match /planes/{uid} {
      allow read: if isAdmin()
        || (soyYo(uid) && get(/databases/$(database)/documents/users/$(uid)).data.estado == "aprobada");
      allow write: if isAdmin();
    }

    // Contador anónimo de aperturas: cualquiera puede apuntar su móvil, solo la administradora lo lee.
    match /aperturas/{id} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(["primera", "ultima", "instalada", "plataforma", "uid"])
        && request.resource.data.ultima == request.time
        && (!("uid" in request.resource.data) || soyYo(request.resource.data.uid));
      allow delete: if isAdmin();
    }
  }
}
